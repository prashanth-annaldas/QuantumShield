# Application Configuration
APP_NAME="Quantum-Inspired Cyber Threat Detection (QDS-Framework)"
ENVIRONMENT="production"
DEBUG=false
HOST="0.0.0.0"
PORT=8000
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL for Production, SQLite for Local Dev)
DATABASE_URL="postgresql://postgres:postgres_secure_password@postgres:5432/qds_db"

# JWT Authentication Secrets (Must be changed in production)
JWT_SECRET_KEY="replace_with_a_secure_random_256_bit_secret_key_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (Comma-separated list or * for local dev)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"
